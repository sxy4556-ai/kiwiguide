# KiwiGuide 配置示例：复制为 .env 后按需修改（.env 不会提交到 git）
# 本项目不需要任何 API 密钥：模型都通过本机 Ollama 调用（云模型需先执行 ollama signin）

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# 对话模型（Ollama 云模型，免费版可用）
LLM_MODEL=gpt-oss:120b-cloud

# 备用本地模型：主模型报错（如额度用完、断网）时使用。选用不带思考的 instruct 版本，
# 本地回答更快；需先执行 ollama pull qwen3:4b-instruct-2507-q4_K_M（约 2.5GB）
FALLBACK_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# 向量模型（稠密检索）
EMBED_MODEL=qwen3-embedding:0.6b

# 稀疏向量模型（BM25 关键词检索，由 fastembed 在本机计算，首次使用时自动下载）
SPARSE_MODEL=Qdrant/bm25

# 数据目录：抓取的网页、向量索引、会话数据库都放在这里
DATA_DIR=data

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
