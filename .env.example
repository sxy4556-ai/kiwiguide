# KiwiGuide 配置示例：复制为 .env 后按需修改（.env 不会提交到 git）
# 本项目不需要任何 API 密钥：模型都通过本机 Ollama 调用（云模型需先执行 ollama signin）

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# 对话模型（Ollama 云模型）
LLM_MODEL=deepseek-v4-flash:cloud

# 备用本地模型：云端额度用完或网络不可用时使用
FALLBACK_LLM_MODEL=qwen3:4b

# 向量模型（稠密检索）
EMBED_MODEL=qwen3-embedding:0.6b

# 数据目录：抓取的网页、向量索引、会话数据库都放在这里
DATA_DIR=data

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
